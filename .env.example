SERE_SECRET_KEY=change-me-in-production
SERE_PUBLIC_BASE_URL=https://sere.cash

# Local SQLite (default). Vercel cannot keep a file database.
# DATABASE_URL=file:./data/sere.db

# Production on Vercel: Turso (libSQL)
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# Skip the Harbor Air demo seed
# SERE_AUTO_SEED=0

# Close the no sign in demo door at /demo
# SERE_DEMO=0

# Integrations are connected per shop with the Connect Stripe button
# (Settings, Overview, Invoices, Payments). These are platform credentials
# for one-click Connect, or a fallback for a single-shop install.

# Card payments through Stripe
# STRIPE_CONNECT_CLIENT_ID=ca_
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# Outgoing email through Resend
# RESEND_API_KEY=
# SERE_EMAIL_FROM=billing@yourshop.com
# SERE_EMAIL_FROM_NAME=Your Shop

# Sere assistant (gpt-4o-mini). Set a $5 monthly budget in OpenAI:
# https://platform.openai.com/settings/organization/limits
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Nova cold outreach — operator only, run from the terminal. See docs/OUTREACH.md.
# The sending domain and provider key MUST differ from the invoice ones above.
# Cold mail draws spam complaints, and a shared domain sinks invoice delivery.
# OUTREACH_OPENAI_API_KEY=
# OUTREACH_MODEL=gpt-4o-mini
# OUTREACH_RESEND_API_KEY=
# OUTREACH_EMAIL_FROM=you@getsere.com
# OUTREACH_EMAIL_FROM_NAME=Isaac
# OUTREACH_REPLY_TO=you@getsere.com
# OUTREACH_SENDER_NAME=Isaac
# OUTREACH_POSTAL_ADDRESS=
# OUTREACH_DATABASE_URL=file:./data/outreach.db
