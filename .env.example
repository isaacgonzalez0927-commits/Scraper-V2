SERE_SECRET_KEY=change-me-in-production
SERE_PUBLIC_BASE_URL=https://sere.cash

# Local SQLite (default). Vercel cannot keep a file database.
# DATABASE_URL=file:./data/sere.db

# Production on Vercel: Turso (libSQL)
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# Skip Harbor Air demo seed
# SERE_AUTO_SEED=0

# Invoice email (optional — without these, send still marks the invoice sent)
# SERE_SMTP_HOST=smtp.example.com
# SERE_SMTP_PORT=587
# SERE_SMTP_USER=
# SERE_SMTP_PASSWORD=
# SERE_SMTP_FROM=Sere <noreply@sere.cash>

# Online card payments (optional)
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
