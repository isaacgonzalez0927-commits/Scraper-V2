SERE_SECRET_KEY=change-me-in-production
SERE_PUBLIC_BASE_URL=https://sere.cash

# Local SQLite (default). Vercel cannot keep a file database.
# DATABASE_URL=file:./data/sere.db

# Production on Vercel: Turso (libSQL)
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# Skip the Harbor Air demo seed
# SERE_AUTO_SEED=0

# Close the no sign in demo door at /demo
# SERE_DEMO=0

# Integrations are connected per shop with the Connect Stripe button
# (Settings, Overview, Invoices, Payments). These are platform credentials
# for one-click Connect, or a fallback for a single-shop install.

# Card payments through Stripe
# STRIPE_CONNECT_CLIENT_ID=ca_
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# Outgoing email through Resend
# RESEND_API_KEY=
# SERE_EMAIL_FROM=billing@yourshop.com
# SERE_EMAIL_FROM_NAME=Your Shop

# Sere assistant (gpt-4o-mini). Set a $5 monthly budget in OpenAI:
# https://platform.openai.com/settings/organization/limits
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ── Nova ─────────────────────────────────────────────────────────────────────
# The console at /nova. gpt-4o by default: she holds opinions and pushes back,
# which a mini model does badly.
# NOVA_OPENAI_API_KEY=          # falls back to OPENAI_API_KEY
# NOVA_MODEL=gpt-4o
# NOVA_TIMEZONE=America/New_York

# ── Nexus: the outreach pipeline Nova commands ───────────────────────────────
# Finding shops. Places bills per call, so one city at a time.
# GOOGLE_PLACES_API_KEY=
# NEXUS_MAX_REVIEW_COUNT=150    # review ceiling; above it a shop is too big for us

# Writing and grading drafts.
# NEXUS_OPENAI_API_KEY=         # falls back to OPENAI_API_KEY
# NEXUS_DRAFT_MODEL=gpt-4o-mini
# NEXUS_REVIEW_MODEL=gpt-4o-mini
# NEXUS_REVIEW_FLOOR=75         # score a draft needs before it may send

# Sending. The domain AND the key MUST differ from RESEND_API_KEY /
# SERE_EMAIL_FROM above. Cold mail draws spam complaints, and a shared sender
# reputation would push shops' invoices into junk.
# NEXUS_SEND_ENABLED=false      # must be exactly "true" to transmit anything
# NEXUS_RESEND_API_KEY=
# NEXUS_EMAIL_FROM=you@getsere.com
# NEXUS_EMAIL_FROM_NAME=Isaac
# NEXUS_REPLY_TO=you@getsere.com
# NEXUS_SENDER_NAME=Isaac
# NEXUS_POSTAL_ADDRESS=         # CAN-SPAM requires a real mailing address
# NEXUS_CTA_URL=https://sere.cash/demo
# NEXUS_MAX_SENDS_PER_DAY=300   # hard ceiling on top of the warmup ramp
# NEXUS_TZ=America/New_York

# Cron secret for POST /api/nexus/tick. Run it every few minutes.
# NEXUS_CRON_SECRET=
